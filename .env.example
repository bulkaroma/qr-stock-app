# Copy to .env for running locally with `npm run dev`. On Vercel, add these under
# Settings → Environment Variables instead. Never commit the real .env file.

# Paste the whole service-account key file on ONE line, wrapped in single quotes:
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

APP_PIN=4827

# Optional: limit the app to the pilot shelf while testing
PILOT_RACKS=1B1,1B2,1B3,1B4,1B5
